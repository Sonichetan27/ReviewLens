# Frontend Client Configuration
# Set VITE_API_URL to point to your backend server
# Development: http://localhost:3000 (or your local server port)
# Production: https://your-vercel-app.vercel.app/api (same domain for monorepo)
VITE_API_URL=/api

# Set to 'true' to use mock data fixtures instead of live API
# Use 'false' for normal API calls to backend
VITE_USE_DUMMY=false
