# ==========================================
# ReviewLens Environment Configuration
# ==========================================

# NOTE: Copy the appropriate section to the respective .env files:
# - Server: Copy to server/.env
# - Client: Copy to client/.env

# ==========================================
# Backend Server Configuration (server/.env)
# ==========================================
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Persistence
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/...
MONGODB_DNS_SERVERS=

# AI Review Analysis (Gemini)
# AI_MODE: 'mock' (deterministic offline) or 'live' (Google Gemini API)
AI_MODE=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ==========================================
# Frontend Client Configuration (client/.env)
# ==========================================
# Set VITE_API_URL to point to your backend server
# Development: http://localhost:3000 (or your local server port)
# Production: https://your-deployed-backend-url.com
VITE_API_URL=http://localhost:3000

# Set to 'true' to use mock data fixtures instead of live API
# Use 'false' for normal API calls to backend
VITE_USE_DUMMY=false
