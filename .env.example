# ==========================================
# ReviewLens Environment Configuration
# ==========================================

# Backend Server Configuration
PORT=
NODE_ENV=
CLIENT_URL=

# Database Persistence
MONGODB_URI=
# Optional comma-separated DNS servers for MongoDB SRV lookups; blank keeps the default.
MONGODB_DNS_SERVERS=

# AI Review Analysis (Gemini)
# AI_MODE: 'mock' (deterministic offline) or 'live' (Google Gemini API)
AI_MODE=
GEMINI_API_KEY=
GEMINI_MODEL=

# Frontend Client Configuration
# In client/.env, set VITE_API_URL to point to Express server
VITE_API_URL=
